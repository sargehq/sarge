# Sarge Project Configuration
# This file configures how 'sarge' manages your project.
# See README.md for full documentation.

# =============================================================================
# Project Metadata
# =============================================================================
[project]
# Project name (derived from directory name)
name = {{.ProjectName | tomlString}}

# When this project was created
created_at = {{.CreatedAt}}

# =============================================================================
# Repository Configuration
# =============================================================================
[repo]
# Repository type: "local" (symlinked) or "github" (cloned)
type = {{.RepoType | tomlString}}

# Original repository path or GitHub URL
source = {{.RepoSource | tomlString}}

# Directory containing the repository (always "main")
path = {{.RepoPath | tomlString}}

# Base branch for creating feature branches (e.g., "main", "develop", "master")
# Used as the target branch for PRs and the starting point for new work branches.
# Defaults to "main" when not specified.
# base_branch = "develop"

# =============================================================================
# Beads Configuration
# =============================================================================
[beads]
# Path to beads directory (relative to project root)
# "main/.beads" = Uses beads in repository (synced with git)
# ".co/.beads" = Project-local beads (standalone, not synced)
path = {{.BeadsPath | tomlString}}

# =============================================================================
# Hooks Configuration (Optional)
# =============================================================================
# Environment variables set when spawning Claude in zellij tabs.
# Useful for configuring Claude Code to use Vertex AI, setting PATH, etc.
#
# [hooks]
# env = [
#   "CLAUDE_CODE_USE_VERTEX=1",
#   "CLOUD_ML_REGION=us-east5",
#   "MY_CUSTOM_VAR=value"
# ]

# =============================================================================
# Agent Configuration (Optional)
# =============================================================================
# Which coding agent to use for this project.
{{- if and .AgentType (ne .AgentType "claude")}}

[agent]
# Agent type: "claude" (default) or "pi"
type = {{.AgentType | tomlString}}
{{- else}}
#
# [agent]
# # Agent type: "claude" (default) or "pi"
# type = "claude"
{{- end}}

# =============================================================================
# Claude Configuration (Optional)
# =============================================================================
# Controls how Claude Code sessions are executed.
{{- if or (eq .AgentType "claude") (eq .AgentType "")}}

[claude]
# Whether to run Claude with --dangerously-skip-permissions flag.
# When true, Claude can execute commands without prompting for confirmation.
# Defaults to true when not specified.
# skip_permissions = false

# Maximum duration in minutes for a Claude session.
# Tasks exceeding this limit are terminated and marked as failed.
# Set to 0 or omit to disable the time limit (default).
# time_limit = 30

# Maximum execution time for a task in minutes.
# Defaults to 60 minutes when not specified.
# If time_limit is set and is less, time_limit takes precedence.
# task_timeout_minutes = 120
{{- else}}
#
# [claude]
# # Whether to run Claude with --dangerously-skip-permissions flag.
# # When true, Claude can execute commands without prompting for confirmation.
# # Defaults to true when not specified.
# skip_permissions = false
#
# # Maximum duration in minutes for a Claude session.
# # Tasks exceeding this limit are terminated and marked as failed.
# # Set to 0 or omit to disable the time limit (default).
# time_limit = 30
#
# # Maximum execution time for a task in minutes.
# # Defaults to 60 minutes when not specified.
# # If time_limit is set and is less, time_limit takes precedence.
# task_timeout_minutes = 120
{{- end}}

# =============================================================================
# Pi Configuration (Optional)
# =============================================================================
# Controls how the pi coding agent is executed (when agent.type = "pi").
# Pi's built-in tools execute without permission prompts by default.
{{- if eq .AgentType "pi"}}

[pi]
# AI provider to use (e.g., "anthropic", "openai", "google")
# provider = "anthropic"

# Model to use with the selected provider
# model = "claude-sonnet-4-5-20250929"

# Thinking/reasoning level: "low", "medium", or "high"
# thinking = "medium"
{{- else}}
#
# [pi]
# # AI provider to use (e.g., "anthropic", "openai", "google")
# provider = "anthropic"
#
# # Model to use with the selected provider
# model = "claude-sonnet-4-5-20250929"
#
# # Thinking/reasoning level: "low", "medium", or "high"
# thinking = "medium"
{{- end}}

# =============================================================================
# Workflow Configuration (Optional)
# =============================================================================
# Controls automated workflow behavior.
#
# [workflow]
# # Maximum number of review/fix cycles before proceeding to PR.
# # Increase for more thorough reviews, decrease to limit iteration time.
# # Defaults to 2 when not specified.
# max_review_iterations = 3

# =============================================================================
# Scheduler Configuration (Optional)
# =============================================================================
# Controls timing for background operations during orchestration.
#
# [scheduler]
# # Interval between PR feedback checks in minutes.
# # How often to check for CI failures and review comments.
# # Defaults to 5 minutes when not specified.
# pr_feedback_interval_minutes = 10
#
# # Interval between comment resolution checks in minutes.
# # How often to check for resolved feedback that needs GitHub updates.
# # Defaults to 5 minutes when not specified.
# comment_resolution_interval_minutes = 10
#
# # Internal scheduler polling frequency in seconds.
# # Defaults to 1 second when not specified.
# scheduler_poll_seconds = 2
#
# # Interval for updating task activity timestamps in seconds.
# # Defaults to 30 seconds when not specified.
# activity_update_seconds = 60

# =============================================================================
# Multiplexer Configuration (Optional)
# =============================================================================
# Controls which terminal multiplexer is used for managing work sessions.
#
# [multiplexer]
# # Which multiplexer to use: "zellij" (default) or "zmx"
# type = "zmx"
#
# # Terminal command template for opening new windows (zmx only).
# # The {session} placeholder is replaced with the zmx session name.
# # macOS default: "open -na Ghostty.app --args -e zmx attach {session}"
# # Linux default: "ghostty -e zmx attach {session}"
# terminal = "open -na Ghostty.app --args -e zmx attach {session}"

# =============================================================================
# Zellij Configuration (Optional)
# =============================================================================
# Controls zellij tab management behavior.
#
# [zellij]
# # Whether to automatically kill zellij tabs when work is destroyed.
# # Includes work, task, console, and claude tabs for the work unit.
# # Defaults to true when not specified.
# kill_tabs_on_destroy = false

# =============================================================================
# Log Parser Configuration (Optional)
# =============================================================================
# Controls how CI logs are analyzed for failures.
#
# [log_parser]
# # Use Claude for log analysis instead of the Go-based parser.
# # When true, CI log failures are analyzed using Claude which can handle
# # any programming language and provide more detailed error context.
# # Defaults to false (use Go parser).
# use_claude = true
#
# # Claude model to use for log analysis: "haiku", "sonnet", or "opus"
# # Haiku is fastest and cheapest, suitable for most log analysis.
# # Sonnet provides more detailed analysis for complex failures.
# # Opus is most capable but slower and more expensive.
# # Defaults to "haiku" when not specified.
# model = "haiku"

# =============================================================================
# IDE Configuration (Optional)
# =============================================================================
# Configure the IDE command for opening worktrees with [i] in the TUI.
#
# [ide]
# # The IDE command to run (e.g., "code", "cursor", "zed", "vim").
# # If not specified, falls back to EDITOR environment variable.
# command = "code"
#
# # Additional arguments to pass to the IDE command.
# # The worktree path is always appended as the final argument.
# args = ["-n"]  # Example: -n opens a new window in VS Code

# =============================================================================
# Debug Configuration (Optional)
# =============================================================================
# Controls debug/diagnostics features.
#
# [debug]
# # Enable the pprof HTTP server on an ephemeral port.
# # When enabled, a pprof endpoint is started on a random available port
# # and the port is recorded in the process table for discovery.
# # Defaults to false when not specified.
# pprof = true

# =============================================================================
# Linear Integration (Optional)
# =============================================================================
# Authentication for importing issues from Linear.
#
# [linear]
# api_key = "lin_api_..."
