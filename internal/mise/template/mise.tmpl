# Sarge mise configuration
# This file configures the CLI tools required for sarge to function.
# See https://mise.jdx.dev/ for mise documentation.

# =============================================================================
# Required Tools
# =============================================================================
[tools]
# Beans - Markdown-file issue tracker for multi-session work
# Used for tracking issues, dependencies, and persistent memory
# Pinned to ensure schema compatibility with sarge's database queries
"go:github.com/hmans/beans" = "0.4.0"

# Pi - AI coding agent
# Used to run AI-powered coding sessions
{{- if .AgentActive}}
"npm:@mariozechner/pi-coding-agent" = "latest"
{{- else}}
# "npm:@mariozechner/pi-coding-agent" = "latest"
{{- end}}

{{- if .GHActive}}
# GitHub CLI - Official GitHub command-line tool
# Used for PR creation, merging, and GitHub API access
gh = "latest"
{{- else}}
# GitHub CLI - Official GitHub command-line tool
# Used for PR creation, merging, and GitHub API access
# gh = "latest"
{{- end}}



# =============================================================================
# Tasks (Optional)
# =============================================================================
# The setup task runs automatically during project/worktree creation.
# Uncomment and customize for your project's needs.

[tasks]
# Project-specific setup - uncomment ONE of these examples or add your own:
# setup = "npm install"                      # Node.js with npm
# setup = "pnpm install"                     # Node.js with pnpm
# setup = "yarn install"                     # Node.js with yarn
# setup = "pip install -r requirements.txt"  # Python
# setup = "bundle install"                   # Ruby
